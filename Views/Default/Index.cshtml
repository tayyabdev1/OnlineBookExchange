<style>

    .animate-slide-up {
        opacity: 0;
        transform: translateY(20px);
        animation: slideUp 1s ease forwards;
    }

    .animate-fade-in {
        opacity: 0;
        animation: fadeIn 1s ease 0.5s forwards;
    }

    @@keyframes slideUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero {
        background: linear-gradient(45deg, rgba(255,255,255,0.9), rgba(255,255,255,0.7)), url("http://img.freepik.com/free-vector/hand-drawn-flat-design-mountain-landscape_23-2149158786.jpg") center/cover;
    }

    /* Strenghtn Animation */
    .reveal {
        opacity: 0;
        transform: translateY(50px);
        transition: all 0.8s ease-in-out;
    }

    .reveal-left {
        transform: translateX(-50px);
    }

    .reveal-right {
        transform: translateX(50px);
    }

    .show {
        opacity: 1;
        transform: translateX(0) translateY(0);
    }



    /* Developer text animation */
    .developer-text {
        position: relative;
        display: inline-block;
        overflow: hidden;
        white-space: nowrap;
        border-right: 2px solid rgba(255, 255, 255, 0.75);
        opacity: 0; /* Hidden initially */
        width: 0; /* Start with no width */
        transition: opacity 0.5s ease-in-out, width 2s ease-in-out;
    }

        /* Activated Class - Animation on Scroll */
        .developer-text.show {
            opacity: 1;
            width: 19ch; /* Adjust according to the word length */
        }

    /* Blinking Cursor */
    @@keyframes blinkingCursor {
        50% {
            border-right-color: transparent;
        }
    }


    /* Temporary debug styles */
    .scroll-animation {
        opacity: 0 !important;
        transition: all 1s ease-out !important;
    }

        .scroll-animation.left {
            transform: translateX(-100px) !important;
        }

        .scroll-animation.right {
            transform: translateX(100px) !important;
        }

        .scroll-animation.visible {
            opacity: 1 !important;
            transform: translateX(0) !important;
        }


    /* Fade-in effect */
    .fade-in {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeIn 1.5s ease-in-out forwards;
        animation-delay: 1.8s; /* Starts after text animation */
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* main text animation */
    .animated-text, .animated-text span {
        animation-duration: 1.7s;
        animation-fill-mode: both;
    }

        .animated-text span {
            display: inline-block;
        }

    .leFlyInBottom span {
        animation-name: leFlyInBottom;
    }

    @@keyframes leFlyInBottom {
        0% {
            transform: translate3d(0px, 8vw, 0px) rotateZ(14deg);
            opacity: 0;
        }

        50% {
            transform: translate3d(0px, 0px, 0px);
            opacity: 1;
            animation-timing-function: ease-in-out;
        }

        100% {
            opacity: 1;
        }
    }


