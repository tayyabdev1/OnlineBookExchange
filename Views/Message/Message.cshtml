@model OnlineBookExchange.ViewModels.MessageViewModel
@{
    ViewBag.Title = "Message";
}
<body class="container my-4">
    <div class="main w-100 d-flex flex-column">
        <p class="text-center">Chat with <strong>@Model.Receivername</strong></p>

        <div id="chatbox" class="border rounded p-3 mb-3 overflow-auto" style="max-height: 400px;">
            @foreach (var message in Model.Messages)
            {
                if (message.SenderID == Model.SenderID)
                {
                    <div class="sent text-end bg-primary text-white p-2 rounded my-1">
                        <strong>You:</strong> @message.Content
                    </div>
                }
                else
                {
                    <div class="received text-start bg-light p-2 rounded my-1">
                        @message.Content<strong>: @Model.Receivername</strong>
                    </div>
                }
            }
        </div>

        <div class="msg-area d-flex gap-2">
            <textarea id="message-content" class="form-control" placeholder="Type Your Message here..."></textarea>
            <button class="btn btn-primary fw-medium" id="send-button">Send</button>
        </div>
    </div>
</body>

<script>
    document.getElementById('send-button').addEventListener('click', function() {
        const content = document.getElementById('message-content').value;

        fetch('/api/message/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                SenderID: @Model.SenderID,
                ReceiverID: @Model.ReceiverID,
                Content: content
            })
        }).then(() => {
            // Append the new message to the chat box
            const newMessage = document.createElement('div');
            newMessage.className = 'sent';
            newMessage.textContent = content;
            chatbox.appendChild(newMessage);

            // Clear the message input field
            document.getElementById('message-content').value = '';
        });
    });
</script>

<style>
    body {
        padding-top: 70px;
    }

    .msg-area {
        display: flex;
        margin-top: 2%;
        gap: 1%;
    }

    textarea {
        resize: vertical;
        width: 30%;
        height: 30px;
        border-radius: 10px;
    }

    #chatbox {
        display: flex;
        flex-direction: column
    }

    .sent {
        text-align: left;
        background-color: #d1f7c4;
        padding: 5px;
        margin: 5px;
        border-radius: 10px;
        display: inline-block;
    }

    .received {
        text-align: right;
        background-color: #f1f1f1;
        padding: 5px;
        margin: 5px;
        border-radius: 10px;
        display: inline-block;
    }
</style>


