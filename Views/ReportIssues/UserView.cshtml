@model IEnumerable<OnlineBookExchange.ViewModels.ReportedIssuesViewModel>

@{
    ViewBag.Title = "Reported Issues";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<body class="container my-4">
    <h2 class="text-center fw-bold">Reported Issues</h2>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Issue ID</th>
                    <th>Reporter ID</th>
                    <th>Book ID</th>
                    <th>User ID</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Created At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model)
                {
                    <tr>
                        <td>@report.IssueID</td>
                        <td>@report.ReporterID</td>
                        <td>@report.BookID</td>
                        <td>@report.UserID</td>
                        <td>@report.Description</td>
                        <td>
                            <span class="badge @(report.Status == "Resolved" ? "bg-success" : "bg-warning")">
                                @report.Status
                            </span>
                        </td>
                        <td>@report.CreatedAt</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>

<style>
    body{
        padding-top: 70px;
    }
</style>
