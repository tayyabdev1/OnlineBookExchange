@model IEnumerable<OnlineBookExchange.ViewModels.ReportedIssuesViewModel>

@{
    ViewBag.Title = "Reported Issues";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<body class="container my-4">
    <h2 class="text-center fw-bold mb-5 display-5 text-primary">Reported Issues</h2>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive rounded-3">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr>
                            <th class="ps-4">Issue ID</th>
                            <th>Reporter</th>
                            <th>Book ID</th>
                            <th>User ID</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="pe-4">Created At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model)
                        {
                            <tr class="position-relative">
                                <td class="ps-4 fw-semibold">#@report.IssueID</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-person-circle me-2 text-muted"></i>
                                        @report.ReporterID
                                    </div>
                                </td>
                                <td>@report.BookID</td>
                                <td>@report.UserID</td>
                                <td class="text-truncate" style="max-width: 200px;">@report.Description</td>
                                <td>
                                    <span class="badge @(report.Status == "Resolved" ? "bg-success" : "bg-warning") rounded-pill d-flex align-items-center">
                                        <i class="bi @(report.Status == "Resolved" ? "bi-check-circle" : "bi-exclamation-triangle") me-1 fs-small"></i>
                                        @report.Status
                                    </span>
                                </td>
                                <td class="pe-4">
                                    <div class="text-nowrap">
                                        <i class="bi bi-clock-history me-2 text-muted"></i>
                                        @report.CreatedAt
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="bi bi-check2-all fs-1"></i>
                                        <p class="mt-3 fs-5">No reported issues found</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>

<style>
    body {
        padding-top: 70px;
    }

    .table thead th {
        font-weight: 600;
        padding: 1rem 0.5rem;
        background: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
    }

    .table tbody td {
        padding: 1rem 0.5rem;
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    .fs-small {
        font-size: 0.75rem;
    }
</style>
