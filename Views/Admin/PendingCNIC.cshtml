@model List<OnlineBookExchange.ViewModels.UserVerificationsViewModel>

<h4 class="mb-4 text-primary">Pending Verifications</h4>

@foreach (var item in Model)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light d-flex justify-content-between align-items-center" data-toggle="collapse" href="#details-@item.UserId" role="button">
            <span><strong>User ID:</strong> @item.UserId</span>
            <span class="text-primary" style="cursor:pointer">View Details ▼</span>
        </div>

        <div class="collapse" id="details-@item.UserId">
            <div class="card-body">
                <h6 class="text-secondary">CNIC Information</h6>
                <p><strong>CNIC Number:</strong> @item.CNICNumber</p>
                <p><strong>Submitted At:</strong> @item.CreatedAt</p>
                <div class="mb-2">
                    <img src="@Url.Content(item.CNICFrontImage)" alt="CNIC Front" class="img-fluid border rounded" />
                </div>
                <div class="mb-3">
                    <img src="@Url.Content(item.CNICBackImage)" alt="CNIC Back" class="img-fluid border rounded" />
                </div>

                <h6 class="text-secondary">Address Information</h6>
                <p><strong>Address:</strong> @item.Address</p>
                <p><strong>City:</strong> @item.City</p>
                <p><strong>Postal Code:</strong> @item.PostalCode</p>
                <p><strong>Submitted At:</strong> @item.AddressCreatedAt</p>
                <label>Reason</label>
                <textarea id="reject-reason-@item.UserId" class="form-control">

                </textarea>
                <div class="d-flex justify-content-end mt-3">
                    <button class="btn btn-success btn-sm mr-2" onclick="UpdateStatus(@item.UserId, 'Approved')">Approve</button>
                    <button class="btn btn-danger btn-sm" onclick="RejectCNIC(@item.UserId, 'Rejected')">Reject</button>
                </div>
            </div>
        </div>
    </div>
}


@section scripts{
    @Scripts.Render("~/bundles/jqueryval")

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>

        function UpdateStatus(userId, status) {
            $.ajax({
                url: '@Url.Action("Approve", "UserVerification")',
                type: 'POST',
                data: { userId: userId, status: status },
                success: function (response) {
                    alert(response.message);
                    setTimeout(() => location.reload(), 1000);
                },
                error: function () {
                    alert("Error updating status.");
                }
            });
        }

        function RejectCNIC(userId, status) {
            var reason = $("#reject-reason-" + userId).val();
            $.ajax({
                url: '@Url.Action("Reject", "UserVerification")',
                type: 'POST',
                data: { userId: userId, status: status, reason: reason },
                success: function (response) {
                    alert(response.message);
                    location.reload();
                },
                error: function () {
                    alert("Error updating status.");
                }
            });
        }


    </script>
}
